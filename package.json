{
  "name": "torchviewer",
  "displayName": "%ext.displayName%",
  "description": "%ext.description%",
  "version": "0.1.0",
  "publisher": "huachao",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huachao1001/VSTorchViewer.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:torchviewer.visualize",
    "onCommand:torchviewer.visualizeFile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "torchviewer.visualize",
        "title": "%cmd.visualize.title%"
      },
      {
        "command": "torchviewer.visualizeFile",
        "title": "%cmd.visualizeFile.title%",
        "icon": "$(circuit-board)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "torchviewer.visualizeFile",
          "when": "resourceExtname == .py",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "torchviewer.visualizeFile",
          "when": "resourceExtname == .py"
        }
      ]
    },
    "configuration": {
      "title": "TorchViewer",
      "properties": {
        "torchviewer.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "%config.pythonPath.description%"
        },
        "torchviewer.defaultInputShape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": [
            1,
            3,
            224,
            224
          ],
          "description": "%config.defaultInputShape.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "debug": "node debug/serve.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1"
  }
}
